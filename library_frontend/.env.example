# Optional environment variables for Ocean Library (Nuxt 3)
# The app runs fully client-side and does NOT require these to start or preview.

# Base HTTP API URL (unused by default)
NUXT_PUBLIC_API_BASE=

# Additional URLs (unused by default)
NUXT_PUBLIC_BACKEND_URL=
NUXT_PUBLIC_FRONTEND_URL=
NUXT_PUBLIC_WS_URL=

# Build/runtime hints (optional)
NUXT_PUBLIC_NODE_ENV=
NUXT_PUBLIC_NEXT_TELEMETRY_DISABLED=
NUXT_PUBLIC_ENABLE_SOURCE_MAPS=
NUXT_PUBLIC_PORT=
NUXT_PUBLIC_TRUST_PROXY=
NUXT_PUBLIC_LOG_LEVEL=
NUXT_PUBLIC_HEALTHCHECK_PATH=

# Feature flags (optional)
# Example JSON: {"experiments":{"bookRating":true}}
# Example tokens: experiments:bookRating
NUXT_PUBLIC_FEATURE_FLAGS=
NUXT_PUBLIC_EXPERIMENTS_ENABLED=
